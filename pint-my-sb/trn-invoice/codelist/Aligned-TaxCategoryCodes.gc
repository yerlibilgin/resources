<?xml version="1.0"?>
<gc:Codelist xmlns:gc="http://docs.oasis-open.org/codelist/ns/genericode/1.0/">
  <gc:Identification>
    <gc:ShortName Lang="en">TaxCat-cat</gc:ShortName>
    <gc:Version>2025</gc:Version>
  </gc:Identification>
  <gc:ColumnSet>
    <gc:Column Id="id" Use="required">
      <gc:ShortName>Identifier</gc:ShortName>
      <gc:Data Type="string"/>
    </gc:Column>
    <gc:Column Id="name" Use="optional">
      <gc:ShortName>Name</gc:ShortName>
      <gc:Data Type="string"/>
    </gc:Column>
    <gc:Column Id="description" Use="optional">
      <gc:ShortName>Description</gc:ShortName>
      <gc:Data Type="string"/>
    </gc:Column>
    <gc:Key Id="idKey">
      <gc:ColumnRef Ref="id"/>
    </gc:Key>
  </gc:ColumnSet>
  <gc:SimpleCodeList>
    <gc:Row>
      <gc:Value ColumnRef="id">
        <gc:SimpleValue>SA</gc:SimpleValue>
      </gc:Value>
      <gc:Value ColumnRef="name">
        <gc:SimpleValue>Sales Tax</gc:SimpleValue>
      </gc:Value>
    </gc:Row>
    <gc:Row>
      <gc:Value ColumnRef="id">
        <gc:SimpleValue>SE</gc:SimpleValue>
      </gc:Value>
      <gc:Value ColumnRef="name">
        <gc:SimpleValue>Service Tax</gc:SimpleValue>
      </gc:Value>
    </gc:Row>
    <gc:Row>
      <gc:Value ColumnRef="id">
        <gc:SimpleValue>HVG</gc:SimpleValue>
      </gc:Value>
      <gc:Value ColumnRef="name">
        <gc:SimpleValue>High-Value Goods Tax</gc:SimpleValue>
      </gc:Value>
    </gc:Row>
    <gc:Row>
      <gc:Value ColumnRef="id">
        <gc:SimpleValue>LVG</gc:SimpleValue>
      </gc:Value>
      <gc:Value ColumnRef="name">
        <gc:SimpleValue>Sales Tax on Low-Value Goods</gc:SimpleValue>
      </gc:Value>
    </gc:Row>
    <gc:Row>
      <gc:Value ColumnRef="id">
        <gc:SimpleValue>E</gc:SimpleValue>
      </gc:Value>
      <gc:Value ColumnRef="name">
        <gc:SimpleValue>Exempt from tax</gc:SimpleValue>
      </gc:Value>
    </gc:Row>
    <gc:Row>
      <gc:Value ColumnRef="id">
        <gc:SimpleValue>O</gc:SimpleValue>
      </gc:Value>
      <gc:Value ColumnRef="name">
        <gc:SimpleValue>Outside scope of tax</gc:SimpleValue>
      </gc:Value>
    </gc:Row>
    <gc:Row>
      <gc:Value ColumnRef="id">
        <gc:SimpleValue>TTX</gc:SimpleValue>
      </gc:Value>
      <gc:Value ColumnRef="name">
        <gc:SimpleValue>Tourism Tax</gc:SimpleValue>
      </gc:Value>
    </gc:Row>
  </gc:SimpleCodeList>
</gc:Codelist>
